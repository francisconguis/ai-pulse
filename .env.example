# Optional LLM provider keys (if omitted, AI Pulse automatically uses its built-in heuristic enricher)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Database & output locations
AI_PULSE_DB_PATH=data/ai_pulse.db
AI_PULSE_EXPORT_DIR=exports

# Scraper settings
AI_PULSE_MAX_ITEMS_PER_SOURCE=15
AI_PULSE_REQUEST_TIMEOUT=20
AI_PULSE_SCHEDULE_MINUTES=180
